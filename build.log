hitespace=True, min_length=7, max_length=20)] = None\n address: Optional[str] = None\n website: Optional[str] = None\n business_type: Optional[str] = None\n tax_id: Optional[str] = None\n description: Optional[str] = None\n # Add more fields as needed for seller onboarding\n\nclass BuyerRegistration(BaseModel):\n full_name: constr(strip_whitespace=True, min_length=1)\n email: EmailStr\n phone: Optional[constr(strip_whitespace=True, min_length=7, max_length=20)] = None\n address: Optional[str] = None\n interests: Optional[List[str]] = None\n company: Optional[str] = None\n # Add more fields as needed for buyer onboarding\n\n# Placeholder for S3 connection\nclass S3Client:\n def __init__(self, bucket_name: str):\n self.bucket_name = bucket_name\n # self.client = boto3.client(\'s3\')\n # Add actual S3 connection logic here\n\n def test_connection(self) -> bool:\n # Implement actual connection test\n return True\n\n# Placeholder for Redis connection\nclass RedisClient:\n def __init__(self, url: str):\n self.url = url\n # self.client = redis.Redis.from_url(url)\n # Add actual Redis connection logic here\n\n def test_connection(self) -> bool:\n # Implement actual connection test\n return True\n\n# Example instantiation (would use env vars in real app)\ns3_client = S3Client(bucket_name="example-bucket")\nredis_client = RedisClient(url="redis://localhost:6379/0")\n\n@app.get("/")\ndef read_root():\n return {"message": "Hello, FastAPI!"}\n\n@app.get("/health")\ndef health_check():\n s3_ok = s3_client.test_connection()\n redis_ok = redis_client.test_connection()\n return {\n "s3": "ok" if s3_ok else "error",\n "redis": "ok" if redis_ok else "error"\n }\n\n# --- Onboarding Registration Endpoints ---\n\n@app.post("/register/seller")\ndef register_seller(seller: SellerRegistration):\n # Save seller data to in-memory and file-based storage\n storage.add_seller(seller.dict())\n return {\n "status": "success",\n "role": "seller",\n "data": seller.dict()\n }\n\n@app.post("/register/